# Copy to .env locally; NEVER commit the real .env file.
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET_SERVER_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_OR_PUBLISHABLE_KEY
MQTT_HOST=your-emqx-cloud-host.example.com
MQTT_PORT=8883
MQTT_USERNAME=REPLACE_ME
MQTT_PASSWORD=REPLACE_ME
SCADA_ALLOWED_RTUS=RTU-01
ALLOW_PUBLIC_REGISTRATION=false
# Optional: additional cross-origin site(s), comma separated. Not needed for same-origin UI.
# CORS_ORIGINS=https://your-custom-frontend.example.com
